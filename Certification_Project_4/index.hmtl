<!DOCTYPE html>
<html>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oxygen:wght@300;400;700&display=swap" rel="stylesheet">
    <title>Carrots</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header id="header">
      <div class="logo">
        <img id="header-img" src="https://icons.veryicon.com/png/o/food--drinks/catering-category/carrot-15.png" alt="carrot logo">
        <h1>Estatic Carrots</h1>
      </div>
      <nav id="nav-bar">
        <ul>
          <li><a class="nav-link" href="#benefits">Benefits</a></li>
          <li><a class="nav-link" href="#video">Expert Opinion</a></li>
          <li><a class="nav-link" href="#plans">Prices</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <section>
        <h1>Home-grown Organic Delicacies</h1>
        <form id="form"  action="https://www.freecodecamp.com/email-submit">
          <input id="email" name="email" type="email" placeholder="Enter your E-mail">
        <input type="submit" id="submit" value="Register Now">
        </form>
      </section>
      <section id="benefits">
        <div class="benefit">
          <img id="benefit-img" src="https://pngimg.com/uploads/vitamins/vitamins_PNG31.png">
          <h3 id="benefit-subtitle">Carrots are an amazing source of vitmains, particularly vitamin A and fiber</h3>
        </div>
        <div class="benefit">
          <img id="benefit-img" src="https://static.vecteezy.com/system/resources/thumbnails/014/551/056/small_2x/eye-icon-simple-flat-eye-design-vision-care-concept-wear-glasses-for-a-clear-vision-png.png">
          <h3 id="benefit-subtitle">Carrots massively improve eye health and can even lead to better eye-sight</h3>
        </div>
        <div class="benefit">
          <img id="benefit-img" src="https://images.vexels.com/media/users/3/137321/isolated/preview/72838e83cb97970f18dcd02d7965c0ed-heart-logo-couple.png">
          <h3 id="benefit-subtitle">Carrots have been kown to improve vascular health and improving heart conditions</3>
        </div>
      </section>
      <section>
        <iframe id="video" width="853" height="480" src="https://www.youtube.com/embed/Jgbv2ZrC1xM" title="A Carrot a Day Keeps the Doctor Away" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </section>
    <section id="plans">
      <div></div>
      <div></div>
      <div></div>
    </section>
    </main>
  </body>
</html>
